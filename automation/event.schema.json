{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOLPHIN Event",
  "type": "object",
  "required": ["id", "date", "title", "event_type", "status", "flyer"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]+$"},
    "date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["live", "session", "live_session"]},
    "importance": {"enum": ["normal", "important"], "default": "normal"},
    "open": {"type": ["string", "null"]},
    "start": {"type": ["string", "null"]},
    "charge": {"type": ["string", "null"]},
    "artist_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "performers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "instrument": {"type": ["string", "null"]},
          "name": {"type": "string"},
          "artist_id": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$"}
        }
      }
    },
    "description": {"type": ["string", "null"]},
    "reservation_url": {"type": ["string", "null"]},
    "status": {"enum": ["draft", "ready", "published", "archived"]},
    "flyer": {
      "type": "object",
      "required": ["mode", "status"],
      "properties": {
        "mode": {"enum": ["canva_ai", "human"]},
        "status": {"enum": ["missing", "generating", "ready"]},
        "source": {"type": ["string", "null"]},
        "github_path": {"type": ["string", "null"]},
        "canva_design_id": {"type": ["string", "null"]}
      }
    },
    "social": {
      "type": "object",
      "properties": {
        "instagram_caption": {"type": ["string", "null"]},
        "facebook_caption": {"type": ["string", "null"]},
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "publish_at", "status"],
            "properties": {
              "channel": {"enum": ["instagram", "facebook"]},
              "publish_at": {"type": "string", "format": "date-time"},
              "status": {"enum": ["planned", "scheduled", "published", "cancelled"]},
              "external_id": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
