{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dolphin.example/event.schema.json",
  "title": "DOLPHIN Event",
  "type": "object",
  "required": ["id", "status", "date", "title", "type", "start_time", "charge", "flyer", "publication"],
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"},
    "status": {"enum": ["draft", "ready", "published", "completed", "cancelled"]},
    "date": {"type": "string", "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["LIVE", "SESSION", "LIVE&SESSION"]},
    "important": {"type": "boolean"},
    "open_time": {"type": ["string", "null"]},
    "start_time": {"type": "string", "minLength": 1},
    "performers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "instrument": {"type": "string"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "description": {"type": "string"},
    "charge": {"type": "string", "minLength": 1},
    "flyer": {
      "type": "object",
      "required": ["mode", "status"],
      "properties": {
        "mode": {"enum": ["canva_ai", "human"]},
        "asset_path": {"type": ["string", "null"]},
        "canva_design_id": {"type": ["string", "null"]},
        "source_assets": {"type": "array"},
        "status": {"enum": ["pending", "ready", "failed"]}
      }
    }
  }
}
