{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOLPHIN Artist",
  "type": "object",
  "required": ["id", "artist_name", "artist_name_en", "instrument", "photo", "profile", "website", "instagram", "youtube", "appearances"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "artist_name": {"type": "string", "minLength": 1},
    "artist_name_en": {"type": "string"},
    "instrument": {"type": "string", "minLength": 1},
    "photo": {"type": "string"},
    "profile": {"type": "string"},
    "website": {"type": "string"},
    "instagram": {"type": "string"},
    "youtube": {"type": "string"},
    "appearances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "event_title", "event_url"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "event_title": {"type": "string", "minLength": 1},
          "event_url": {"type": "string"}
        }
      }
    }
  }
}
